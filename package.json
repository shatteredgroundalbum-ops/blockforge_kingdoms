{
  "name": "blockforge-kingdoms",
  "version": "0.1.0",
  "private": true,
  "description": "BLOCKFORGE: KINGDOMS - a stylized 3D voxel action-survival game (vertical slice)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
